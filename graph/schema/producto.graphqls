scalar Time

type Producto {
  id:          ID!
  nombre:      String!
  descripcion: String
  precio:      Float!
  createdAt:   Time!
  updatedAt:   Time!
  categoria:   Categoria
  inventario:  Inventario
}

type Categoria {
  id:          ID!
  nombre:      String!
  descripcion: String
  productoIds: [String!]!
  productos:   [Producto!]!
}

type Inventario {
  id:         ID!
  productoId: ID!
  cantidad:   Int!
  almacen:    String!
}

input CreateProductoInput {
  nombre:      String!
  descripcion: String
  precio:      Float!
}

input UpdateProductoInput {
  nombre:      String
  descripcion: String
  precio:      Float
}

input CreateCategoriaInput {
  nombre:      String!
  descripcion: String
  productoIds: [String!]
}

input UpdateCategoriaInput {
  nombre:      String
  descripcion: String
  productoIds: [String!]
}

input CreateInventarioInput {
  productoId: String!
  cantidad:   Int!
  almacen:    String!
}

input UpdateInventarioInput {
  cantidad: Int
  almacen:  String
}

type Query {
  productos(page: Int = 1, limit: Int = 20): [Producto!]!
  producto(id: ID!): Producto
  categorias: [Categoria!]!
  categoria(id: ID!): Categoria
  inventarios: [Inventario!]!
  inventario(id: ID!): Inventario
  inventarioByProducto(productoId: ID!): Inventario
}

type Mutation {
  crearProducto(input: CreateProductoInput!): Producto!
  actualizarProducto(id: ID!, input: UpdateProductoInput!): Producto!
  eliminarProducto(id: ID!): Boolean!
  crearCategoria(input: CreateCategoriaInput!): Categoria!
  actualizarCategoria(id: ID!, input: UpdateCategoriaInput!): Categoria!
  eliminarCategoria(id: ID!): Boolean!
  crearInventario(input: CreateInventarioInput!): Inventario!
  actualizarInventario(id: ID!, input: UpdateInventarioInput!): Inventario!
  eliminarInventario(id: ID!): Boolean!
}
